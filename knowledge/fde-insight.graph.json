      "type": "system",
      "name": "Agent 平台",
      "nameEn": "Agent platform",
      "definition": "承载模型、上下文、工具、流程、运行时、评测和发布治理的开发与运行平台。",
      "sourceRefs": ["report:p25-26", "report:p32-36"]
    },
    {
      "id": "system-enterprise-systems",
      "type": "system",
      "name": "企业业务系统",
      "nameEn": "Enterprise systems",
